# Phase 5.4 live-node test environment variables.
# Copy to `.env` (gitignored) and fill in. Do NOT commit a populated .env.
#
# Source the file before running tests:
#   set -a; source .env; set +a
#   cargo test --features live -- --test-threads=1

# --- node ---
YOLO_NODE_URL=http://127.0.0.1:9054
YOLO_NODE_API_KEY=<api key — Blake2b256 of this string must match api.security.api_key_hash in sigmachain-testnet.toml>

# --- wallet ---
# The node must already have a wallet restored. The mnemonic is NOT in
# this file — it's a one-shot ceremony documented in SETUP.md.
YOLO_WALLET_PASSWORD=<password used at /wallet/restore time>

# --- timeouts (optional) ---
# YOLO_POLL_MS=500
# YOLO_BLOCK_TIMEOUT_MS=60000
# YOLO_TX_TIMEOUT_MS=30000
